# PostgreSQL connection - assembled into a SQLAlchemy URL by app/config.py
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=a11y
POSTGRES_PORT=5432

# JWT settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Crawler defaults
CRAWLER_DEFAULT_MAX_DEPTH=3
CRAWLER_DEFAULT_MAX_PAGES=200
CRAWLER_CONCURRENCY=8
CRAWLER_REQUEST_TIMEOUT_SECONDS=10

ENVIRONMENT=development

# Optional default user, created by `python -m scripts.seed_admin` for
# local/dev convenience. Leave blank (or remove) in real deployments.
DEFAULT_ADMIN_FULL_NAME=WinVinaya Admin
DEFAULT_ADMIN_EMAIL=info@winvinaya.com
DEFAULT_ADMIN_PASSWORD=Testpass@123

# AI Audit Agent (Phase 2) - Multi-Provider LLM Configuration
# Fallback hierarchy: 1. Claude Sonnet (Anthropic) -> 2. Google Gemini -> 3. Groq
# Requires Postgres with the pgvector extension available (CREATE EXTENSION vector)
# and `playwright install chromium` run once after `pip install -r requirements.txt`.

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Google Gemini API Keys (comma-separated for round-robin rotation)
GEMINI_API_KEYS=

# Groq API Keys (comma-separated for round-robin rotation)
GROQ_API_KEYS=

AI_MODEL_PLANNER=claude-sonnet-4-6
AI_MODEL_JUDGMENT=claude-sonnet-4-6
AI_MODEL_REFLECTION=claude-sonnet-4-6
AI_MODEL_FALLBACKS=claude-sonnet-4-6,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash,groq/llama-3.3-70b-versatile,groq/openai/gpt-oss-20b

AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=16000
AI_JUDGMENT_THINKING_BUDGET=512
AI_PLANNING_THINKING_BUDGET=2048
WCAG_CONFORMANCE_LEVEL=AA
AI_EMBEDDING_DIMENSIONS=256
AI_MEMORY_TOP_N=5
